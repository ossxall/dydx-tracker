POSTGRES_DB=dydx_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-this-password

# La red y el usuario se crean con scripts/start-indexer.sh y
# scripts/create-indexer-reader.sh. El password debe ser hexadecimal/URL-safe.
INDEXER_DB_PASSWORD=replace-with-64-hex-characters
INDEXER_DOCKER_NETWORK=dydx-indexer_default

START_AT=2024-11-17T00:00:00Z
POLL_INTERVAL_SECONDS=5
BATCH_SIZE=1000
REPLAY_BLOCKS=20
