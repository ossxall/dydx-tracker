# Comprueba que esta release ya es compatible con mainnet antes de instalar.
PROTOCOL_VERSION=v9.9.0
NODE_NAME=dydx-tracker-fullnode
NODE_HOME=${HOME}/.dydxprotocol
NODE_KAFKA_ADDR=127.0.0.1:29092
NODE_RPC_LISTEN=tcp://0.0.0.0:26657
MIN_ARCHIVE_FREE_GB=12000
ALLOW_UNDER_SPECCED=false

# Necesario para que Cosmovisor descargue los binarios indicados por upgrades
# on-chain al sincronizar desde genesis. Revisa la política de seguridad antes.
DAEMON_ALLOW_DOWNLOAD_BINARIES=true

# El nodo se prepara desde genesis, sin snapshot, para emitir los eventos
# históricos a Kafka. Se requieren varios TB y una sincronización prolongada.
NODE_SYNC_FROM_GENESIS=true
